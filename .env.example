# Base URL of the Django backend (no trailing slash). Next proxies /api/* to `${API_URL}/api/*/`.
# Local default: http://localhost:8000. On Vercel set it to the deployed Django URL.
API_URL=http://localhost:8000

# Optional: poll for file changes in dev (needed for WSL checkouts under /mnt/c). Milliseconds.
# WATCH_POLL_MS=1000
